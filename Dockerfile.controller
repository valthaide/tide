# Build stage
FROM golang:1.25-alpine AS builder

WORKDIR /app

# Copy go mod and sum files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# VERSION is the image tag (v1.0.6) from CI. Empty stays "dev".
ARG VERSION=dev
RUN CGO_ENABLED=0 GOOS=linux go build \
      -ldflags "-s -w -X main.Version=${VERSION}" \
      -o /app/conops ./cmd/conops \
 && CGO_ENABLED=0 GOOS=linux go build \
      -ldflags "-s -w -X github.com/valthaide/conops-private/cmd/cps/cmd.Version=${VERSION}" \
      -o /app/cps ./cmd/cps

# Final stage
FROM alpine:3.19

ARG TARGETARCH=amd64

WORKDIR /app

# docker CLI, compose, git/ssh for monolith apply (SOPS removed; secrets via env files)
RUN apk add --no-cache docker-cli docker-cli-compose git openssh-client ca-certificates \
 && mkdir -p /root/.ssh && chmod 700 /root/.ssh

# Copy the binaries from builder. cps is on PATH for `cps version`.
COPY --from=builder /app/conops .
COPY --from=builder /app/cps /usr/local/bin/cps

# Expose port
EXPOSE 8080

# Command to run
CMD ["./conops"]
