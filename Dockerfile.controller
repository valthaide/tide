# Build stage
FROM golang:1.25-alpine AS builder

WORKDIR /app

# Copy go mod and sum files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# VERSION is the image tag from CI. Empty stays "dev".
ARG VERSION=dev
RUN CGO_ENABLED=0 GOOS=linux go build \
      -ldflags "-s -w -X main.Version=${VERSION}" \
      -o /app/tide ./cmd/tide \
 && CGO_ENABLED=0 GOOS=linux go build \
      -ldflags "-s -w -X github.com/valthaide/tide/cmd/tidectl/cmd.Version=${VERSION}" \
      -o /app/tidectl ./cmd/tidectl

# Final stage. CLI and Compose come from docker:27-cli (API 1.47).
FROM docker:27-cli@sha256:851f91d241214e7c6db86513b270d58776379aacc5eb9c4a87e5b47115e3065c AS dockercli

FROM alpine:3.19

WORKDIR /app

COPY --from=dockercli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=dockercli /usr/local/libexec/docker/cli-plugins/docker-compose /usr/local/libexec/docker/cli-plugins/docker-compose

RUN apk add --no-cache git openssh-client ca-certificates \
 && mkdir -p /root/.ssh && chmod 700 /root/.ssh \
 && chmod 755 /usr/local/bin/docker /usr/local/libexec/docker/cli-plugins/docker-compose \
 && api="$(docker version --format '{{.Client.APIVersion}}' 2>/dev/null || true)" \
 && echo "docker client API ${api}" \
 && awk -v got="$api" -v min="1.44" 'BEGIN { split(got, a, "."); split(min, b, "."); if ((a[1]+0 > b[1]+0) || (a[1]+0 == b[1]+0 && a[2]+0 >= b[2]+0)) exit 0; exit 1 }' \
      || { echo "docker client API ${api} is below 1.44" >&2; exit 1; } \
 && docker compose version

# Copy binaries from builder. Transitional compatibility alias symlinks are kept for one release.
COPY --from=builder /app/tide /app/tide
COPY --from=builder /app/tidectl /usr/local/bin/tidectl
RUN ln -s /usr/local/bin/tidectl /usr/local/bin/cps \
 && ln -s /app/tide /usr/local/bin/tide

EXPOSE 8443 8081

ENTRYPOINT ["/app/tide"]
